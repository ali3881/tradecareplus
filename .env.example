# App
NODE_ENV="development"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace_with_secure_random_secret"

# Database
DATABASE_URL="postgresql://user:password@host:5432/tradecareplus?schema=public"

# OpenAI
OPENAI_API_KEY="sk-proj-replace_me"

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="replace_me"

# Stripe
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"

# Pusher
PUSHER_APP_ID="replace_me"
PUSHER_KEY="replace_me"
PUSHER_SECRET="replace_me"
PUSHER_CLUSTER="mt1"

# AWS S3
AWS_ACCESS_KEY_ID="replace_me"
AWS_SECRET_ACCESS_KEY="replace_me"
